# Copy this file to /etc/career-ops/secrets.env on the VM (chmod 600).
# For local development, copy to career-ops-web/.env instead — server.js
# falls back to dotenv when /etc/career-ops/secrets.env does not exist.

# Gemini Flash — get free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Apify — free account at https://apify.com (no credit card required)
APIFY_TOKEN=your_apify_token_here

# Session security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_64_char_hex_here

# CV encryption key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CV_ENCRYPTION_KEY=your_64_char_hex_here

# Invite code shared with your friends (change this to something memorable)
INVITE_CODE=your_invite_code_here

# Netlify deploy URL — set after Phase 8 is complete
ALLOWED_ORIGIN=https://your-app.netlify.app

# Local data directory override (defaults to /var/career-ops-data on the VM)
DATA_DIR=./data

# Optional: override the @sparticuz/chromium-min binary pack URL used for PDF
# export (Phase 6). Must match the @sparticuz/chromium-min version pinned in
# package.json. Defaults to the matching GitHub release pack if unset.
# CHROMIUM_PACK_URL=https://github.com/Sparticuz/chromium/releases/download/v123.0.1/chromium-v123.0.1-pack.tar
